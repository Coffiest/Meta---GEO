// GEO(仮称)戦略DBの基礎スキーマ。
// 「全ハンド・全アクションを記録し、後からスポットごとに検索・分析できる」というコンセプトの核。
// ローカル開発ではこの環境のPostgres、本番ではSupabase Postgresを想定(DATABASE_URLを切り替えるだけ)。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  /// Supabase Authのユーザーid(auth.users.id)。BOTユーザーはnull。
  authId       String?   @unique
  email        String?   @unique
  displayName  String
  /// プリセットアバターのキー(apps/web側の定義と対応)。未選択はnull。
  avatarKey    String?
  /// 初回オンボーディング(名前+アバター設定)を完了したか。未完了ユーザーはホームに入れない。
  onboarded    Boolean   @default(false)
  isBot        Boolean   @default(false)
  /// 友達招待用のコード(例 "K7QMX2AB")。ホームの招待カードを初めて開いたときに発行する。
  /// 未発行はnull(BOTには発行しない)。
  referralCode String?   @unique
  /// 招待カードを最後に開いたときの接続元(IP の鍵付きハッシュ)。同じネットワークからの自己招待を弾くのに使う。
  referralIpHash String?
  /// GEO データベースの利用条件を管理者が個別に緩めたもの("preflop" | "full")。null = インマネの回数どおり。
  /// 回数で届く段階より低い値は効かない(回数で得た段階を取り上げない)。
  geoAccessOverride String?
  /// 無料体験を使った時刻(全プランを通して1人1回。オーナー確定)。null = まだ使っていない。
  trialUsedAt  DateTime?
  /// 7日間無料の特別オファー(オーナー確定 2026-10-12): インマネ10回ごとに1回、1時間だけ出る。
  /// trialOfferMilestone = 最後にオファーを出したインマネの区切り(10, 20, 30…)。trialOfferUntil = その期限(使ったら null)。
  trialOfferMilestone Int @default(0)
  trialOfferUntil     DateTime?
  /// 管理者が付与したプラン("silver" | "gold" | "platinum")と期限。Stripe の契約とは別に持ち、高い方が効く
  /// (支払い中の人にも上位プランを付与できるように。オーナー指示)。期限切れ・null は無し。
  adminPlan      String?
  adminPlanUntil DateTime?
  createdAt    DateTime  @default(now())
  /// アカウント削除(退会)した時刻。未削除はnull。
  ///
  /// 重要: 退会しても User 行そのものは消さない。ハンド履歴(Hand/HandSeat)=GEO DATABASE の
  /// 実データが HandSeat.userId で User を参照しており、行を消すと集計対象のハンドまで
  /// 巻き添えになるため。退会処理では認証情報と表示名を匿名化するだけにして、
  /// GEOの集計結果は退会前とまったく同じに保つ。
  deletedAt    DateTime?

  tournamentEntries    TournamentEntry[]
  handSeats            HandSeat[]
  bankrollTransactions BankrollTransaction[]
  subscription         Subscription?
  referralsSent        Referral[]            @relation("ReferralInviter")
  referralReceived     Referral?             @relation("ReferralInvitee")
  pushSubscriptions    PushSubscription[]
  premiumCoupon        PremiumCoupon?
  couponsOwned         PremiumCouponCode[]   @relation("CouponOwner")
  couponsRedeemed      PremiumCouponCode[]   @relation("CouponRedeemer")
  errorReports         ErrorReport[]
  feedbacks            Feedback[]

  @@index([deletedAt])
}

/// Web Push(PWAプッシュ通知)の購読情報。1ユーザーが複数端末を登録できる。
/// 送信時に失効(410/404)が返った購読はその場で削除する(死んだ購読を溜めない)。
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  /// プッシュサービスのエンドポイントURL。端末+ブラウザごとに一意。
  endpoint  String   @unique
  /// 暗号化キー(購読オブジェクトの keys.p256dh / keys.auth)。
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

/// 招待コードの成立記録(招待した人 × 招待された人)。
/// 特典は「棋譜解析プラン1ヶ月無料クーポン」を1招待につき1枚発行(PremiumCouponCode)。
/// バーチャルチップは一切動かさない —— チップを配ると自己招待による増殖と射幸性の問題が出るため。
/// 招待される側は生涯1回だけ(inviteeUserIdが一意)。
model Referral {
  id            String   @id @default(uuid())
  /// 招待した側のUser.id
  inviterUserId String
  inviter       User     @relation("ReferralInviter", fields: [inviterUserId], references: [id])
  /// 招待された側のUser.id。1人につき1回だけ適用できる。
  inviteeUserId String   @unique
  invitee       User     @relation("ReferralInvitee", fields: [inviteeUserId], references: [id])
  /// 適用時に入力された招待コード(発行後に変わることはないが、履歴として残す)。
  code          String
  /// 特典の状態。pending=招待された人がまだ遊んでいない / rewarded=クーポン発行済み /
  /// ineligible=同じネットワークからの招待などで特典の対象外(複数アカウントの自作自演の対策)。
  status        String   @default("pending")
  /// クーポンを発行した時刻(30日あたりの上限の判定に使う)。
  rewardedAt    DateTime?
  /// 招待された人がコードを適用したときの接続元(IP の鍵付きハッシュ。生の IP は持たない)。
  ipHash        String?
  createdAt     DateTime @default(now())

  @@index([inviterUserId, createdAt])
}

/// 招待特典として発行される「棋譜解析プラン1ヶ月無料」クーポン。招待が1件成立するごとに1枚
/// 発行され、獲得した人はいつでも一覧で確認・コピーできる。
///
/// 発行しただけでは無料期間は始まらない —— 棋譜解析の画面でコードを適用したときに初めて
/// PremiumCoupon(下)の期限が伸びる。使うタイミングを本人が選べるようにするための設計。
/// コードは1枚1回だけ使える(redeemedAt が立ったら再利用不可)。
model PremiumCouponCode {
  id               String    @id @default(uuid())
  /// 人が読める一意なコード(表示は "GEO-XXXX-XXXX"、保存は区切りなしの英数字)。
  code             String    @unique
  /// このクーポンを獲得した人。
  ownerUserId      String
  owner            User      @relation("CouponOwner", fields: [ownerUserId], references: [id])
  /// 適用すると付与される無料月数(days があればそちらを使う)。
  months           Int       @default(1)
  /// 適用すると付与される無料日数。招待の特典は1週間(7)。古いクーポンは null(months を使う)。
  days             Int?
  /// 発行理由(referral=友達招待)。将来キャンペーン等で増やせるようにしている。
  source           String    @default("referral")
  /// 発行元の招待。1招待につき1枚だけ発行するための冪等キー(招待以外の発行はnull)。
  referralId       String?   @unique
  /// 適用された時刻。未適用ならnull。
  redeemedAt       DateTime?
  /// 適用した人。コードは共有できるため、獲得者(owner)とは別に記録する。
  redeemedByUserId String?
  redeemedBy       User?     @relation("CouponRedeemer", fields: [redeemedByUserId], references: [id])
  createdAt        DateTime  @default(now())

  @@index([ownerUserId, createdAt])
}

/// クーポンを適用して得られる「棋譜解析プランの無料アクセス権」。1ユーザー1行で、クーポンを
/// 使うたびに expiresAt を1ヶ月ずつ積み上げる(有効期限が残っていればその後ろへ伸ばす)。
///
/// Subscription(Stripe契約・管理者付与comp)とは別テーブルにしている。1ユーザー1行のSubscriptionへ
/// 書き込むと、課金中ユーザーのstatus/期間をこちらが上書きして契約情報を壊しかねないため。
/// 有料判定(getSubscriptionStatusForUser)は Stripe契約 / comp / このクーポン のORで行う。
model PremiumCoupon {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])
  /// この特典で無料アクセスできる期限。
  expiresAt     DateTime
  /// 累計で付与された月数(表示用)。
  monthsGranted Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([expiresAt])
}

/// GEO戦略DB(レンジ分析)の月額サブスクリプション状態。Stripeのsubscriptionオブジェクトと
/// stripeSubscriptionId/stripeCustomerIdで対応させ、Webhookでstatusを同期する。
model Subscription {
  id                   String    @id @default(uuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id])
  stripeCustomerId     String    @unique
  stripeSubscriptionId String?   @unique
  /// "active" | "trialing" | "past_due" | "canceled" | "incomplete"
  status               String
  /// 契約しているプラン("silver" | "gold" | "platinum")。旧来の ¥980 の契約はシルバー(オーナー確定)。
  /// Stripe の契約は Webhook で価格から決める。管理者の無料付与(comp)は付与時に選んだプラン。
  plan                 String    @default("silver")
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([status])
}

/// 棋譜解析(トーナメント単位)の無料枠トラッキング。無料プランは24時間ローリングで1回まで。
/// (userId, tournamentId)で一意=同一トナメの再解析は消費しない(冪等)。直近24時間の行数で判定する。
model ReviewUsage {
  id           String   @id @default(uuid())
  userId       String
  tournamentId String
  createdAt    DateTime @default(now())

  @@unique([userId, tournamentId])
  @@index([userId, createdAt])
}

/// プレイヤーメモ&マーキング。あるユーザー(author)が対戦相手(target)につける
/// 色分類(赤/橙/黄/青/紫)+自由記述メモ。GTO WizardやTenFourのHUD的な「相手ノート」機能。
/// author×targetで一意(1相手につき1メモ)。
model PlayerNote {
  id           String   @id @default(uuid())
  /// メモを付けた本人のUser.id
  authorUserId String
  /// メモの対象プレイヤーのUser.id
  targetUserId String
  /// 色分類。"red"|"orange"|"yellow"|"blue"|"purple" のいずれか、未設定はnull。
  color        String?
  /// 自由記述メモ本文。
  note         String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([authorUserId, targetUserId])
  @@index([authorUserId])
  @@index([targetUserId])
}

/// ユーザーからの通報。チャット等のユーザー生成コンテンツに対する必須の通報導線
/// (App Store審査ガイドライン1.2「ユーザー生成コンテンツ」対応)。管理者が内容を確認するための
/// 記録のみを残し、自動処理(即時BAN等)は行わない。
model PlayerReport {
  id             String   @id @default(uuid())
  /// 通報した本人のUser.id
  reporterUserId String
  /// 通報された相手のUser.id
  reportedUserId String
  /// 理由の分類。"harassment"(嫌がらせ)|"inappropriate"(不適切な発言)|"cheating"(不正行為)|"other"。
  reason         String
  /// 補足(問題のメッセージ本文など)。自由記述、無くてもよい。
  context        String   @default("")
  createdAt      DateTime @default(now())

  @@index([reporterUserId])
  @@index([reportedUserId])
}

/// ユーザーによるブロック。ブロックした相手のチャット発言は、ブロックした本人の画面にのみ
/// 表示されなくなる(App Store審査ガイドライン1.2「ユーザー生成コンテンツ」対応)。
/// 双方向ではなく片方向(blockerだけがblockedを見えなくする)。
model PlayerBlock {
  id            String   @id @default(uuid())
  /// ブロックした本人のUser.id
  blockerUserId String
  /// ブロックされた相手のUser.id
  blockedUserId String
  createdAt     DateTime @default(now())

  @@unique([blockerUserId, blockedUserId])
  @@index([blockerUserId])
  @@index([blockedUserId])
}

/// バンクロール(バーチャルチップの持ち点)の増減台帳。残高はこの台帳のamount合計で常に導出する
/// (別に「現在残高」フィールドをキャッシュしない。導出元は常にこの台帳の1本にする)。
model BankrollTransaction {
  id           String      @id @default(uuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  /// 正=入金(サインアップボーナス・賞金)、負=出金(バイイン)
  amount       Int
  kind         String // "signupBonus" | "buyIn" | "payout" | "adjustment"
  tournamentId String?
  tournament   Tournament? @relation(fields: [tournamentId], references: [id])
  createdAt    DateTime    @default(now())

  @@index([userId, createdAt])
}

model Tournament {
  id            String    @id @default(uuid())
  /// "sng" | "mtt"。ロビーでの選択に対応。
  gameType      String    @default("sng")
  /// 参加費(バンクロールから引かれる額)。トーナメント内のチップ数(startingStack)とは別概念。
  buyIn         Int       @default(0)
  /// SNG の階層: "regular"(参加費1,000)| "highRoller" | "superHighRoller"。MTT は "regular"。
  tier          String    @default("regular")
  /// 1位から順の賞金。トーナメント単位で1回だけ持つ(ハンドごとに繰り返さない)。
  payouts       Int[]
  seatCount     Int
  startingStack Int
  status        String    @default("waiting") // "waiting" | "running" | "finished"
  createdAt     DateTime  @default(now())
  finishedAt    DateTime?

  entries              TournamentEntry[]
  hands                Hand[]
  bankrollTransactions BankrollTransaction[]
}

model TournamentEntry {
  id                 String     @id @default(uuid())
  tournamentId       String
  tournament         Tournament @relation(fields: [tournamentId], references: [id])
  userId             String
  user               User       @relation(fields: [userId], references: [id])
  seatIndex          Int
  finishPosition     Int?
  bustedAtHandNumber Int?
  /// 着順に応じてバンクロールへ払い出した額(0=賞金圏外)。
  payout             Int        @default(0)

  @@unique([tournamentId, seatIndex])
  @@index([userId])
}

model Hand {
  id               String     @id @default(uuid())
  tournamentId     String
  tournament       Tournament @relation(fields: [tournamentId], references: [id])
  handNumber       Int
  levelSmallBlind  Int
  levelBigBlind    Int
  levelAnte        Int
  buttonFixedPos   Int
  board            String[] // 例: ["9s","8s","7s","6h","2d"]
  potTotal         Int
  wonByFold        Boolean
  createdAt        DateTime   @default(now())
  /// ── 研究用(データベースタブの「データ研究」)。古いハンドは null ──
  /// ハンドを配った時刻と、決着した時刻(サーバー時計)。
  startedAt        DateTime?
  endedAt          DateTime?
  /// ハンド開始時点のトーナメント全体の生存人数(MTT は全卓)。
  playersRemaining Int?
  /// トーナメントの総エントリー数。
  entryCount       Int?
  /// 入賞人数(賞金のある順位の数)。
  itmPlaces        Int?
  /// 1位から順の賞金(ICM の期待賞金の計算用)。トーナメントの賞金(Tournament.payouts)と同じなら空にする
  /// (MTT のように途中で賞金が変わるときだけ、そのハンド時点の値を持つ)。
  payouts          Int[]
  /// ハンド開始時点の全生存者のスタック(MTT は全卓。ICM の計算用)。並びに意味は無い。
  fieldStacks      Int[]

  seats     HandSeat[]
  actions   HandAction[]
  pots      HandPot[]
  reviews   HandReview[]
  decisions GeoDecision[]
  facts     DecisionFact[]

  @@unique([tournamentId, handNumber])
  /// GEO集計は常に createdAt 昇順で走査するため、全件ソートを避けるインデックス。
  @@index([createdAt])
  /// ポストフロップGEOは板面でハンドを絞り込む(board @> ARRAY[...])。配列包含はGINが効く。
  @@index([board(ops: ArrayOps)], type: Gin)
}

/// そのハンドにおける各プレイヤーの着席情報。GEO分析上、全ハンド終了後はホールカードを常に記録する
/// (Ten-Four Pokerの「全履歴公開」思想を踏襲)。
model HandSeat {
  id               String   @id @default(uuid())
  handId           String
  hand             Hand     @relation(fields: [handId], references: [id])
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  seatIndex        Int
  startingStack    Int
  holeCards        String[]
  isSmallBlind     Boolean  @default(false)
  isBigBlind       Boolean  @default(false)
  resultStackDelta Int
  /// Historyタブでプレイヤーが「お気に入り」登録したハンドかどうか。
  isFavorite       Boolean  @default(false)
  /// そのハンド中、このプレイヤーが離席状態(自動チェック/フォールド)だったか。
  /// 離席中の意思決定は本人の戦略ではないため、GEO戦略分析の集計から除外する。
  wasAway          Boolean  @default(false)
  /// 管理者がGEO戦略DBから除外(論理削除)したか。アクション行そのものは残す(物理削除すると
  /// 同卓他プレイヤーのライン再生が壊れるため)が、GEO集計のサンプルには一切含めない。
  excludedFromGeo  Boolean  @default(false)

  decisions GeoDecision[]

  @@unique([handId, seatIndex])
  @@index([userId])
}

/// GEO分析の核となる、ハンド内の全アクションの時系列ログ
model HandAction {
  id             String    @id @default(uuid())
  handId         String
  hand           Hand      @relation(fields: [handId], references: [id])
  sequenceNumber Int
  seatIndex      Int
  street         String // "preflop" | "flop" | "turn" | "river"
  kind           String // "fold" | "check" | "call" | "bet" | "raise" | "allIn" | "postBlind" | "postAnte"
  toAmount       Int?
  potBefore      Int
  /// ── 研究用。古いハンドは null ──
  /// 行動した時刻(サーバー時計)。人間の手番だけ記録する(自動で卓を埋めるプレイヤーは null。NULL はほぼ容量を食わない)。
  /// 手番が回ってきた時刻は actedAt − thinkMs で求まるので持たない。
  actedAt        DateTime?
  /// 思考時間(ms)。自動で卓を埋めるプレイヤーの行と、ブラインド/アンティの支払いは null。
  thinkMs        Int?
  /// 時間切れによる自動のチェック/フォールドか。
  timedOut       Boolean   @default(false)
  /// タイムバンクを使って考えたか。
  timeBankUsed   Boolean   @default(false)

  @@index([handId, sequenceNumber])
}

/// 研究用に事前展開した「1アクション = 1行」のテーブル(データベースタブの「データ研究」)。
///
/// 思考時間・状況・その時点の優勝率/インマネ率・直前に大きいポットを取った/落とした、などの
/// 相関を GROUP BY 1本で集計できるよう、帯(バケット)まで焼き込んでおく。Hand / HandAction /
/// HandSeat から何度でも作り直せる派生データ(`packages/db/src/decisionFacts.ts`)。
///
/// 自動で卓を埋めるプレイヤーの行も書く(isBot)が、集計 API は常に人間だけを対象にし、
/// isBot を画面や応答に出すことは無い。
model DecisionFact {
  id             String  @id @default(uuid())
  handId         String
  hand           Hand    @relation(fields: [handId], references: [id], onDelete: Cascade)
  tournamentId   String
  userId         String
  gameType       String
  handNumber     Int
  sequenceNumber Int     @db.SmallInt
  street         String
  kind           String
  /// "fold" | "passive"(チェック/コール) | "aggressive"(ベット/レイズ/オールイン)
  actionClass    String
  /// そのプレイヤーのそのハンドの最初の行(ハンド単位の指標を数えるときの目印)。
  firstInHand    Boolean
  /// そのハンドで自発的にポットに入れたか(VPIP)/プリフロップでレイズしたか(PFR)。
  handVpip       Boolean
  handPfr        Boolean

  // 時間
  thinkMs      Int?
  thinkBucket  String
  timedOut     Boolean
  timeBankUsed Boolean

  // 状況
  position      String
  playersInHand Int     @db.SmallInt
  playersActive Int     @db.SmallInt
  bigBlind      Int
  potBb         Float   @db.Real
  facingBb      Float?  @db.Real
  /// ベット/レイズの額 ÷ ポット(アグレッシブな行のみ)。
  betSizePot    Float?  @db.Real
  betSizeBucket String
  stackBb       Float   @db.Real
  effStackBb    Float   @db.Real
  stackBucket   String
  spr           Float?  @db.Real
  handClass     String?
  madeHand      String?
  hasDraw       Boolean
  boardTexture  String?
  /// Notion の場面(cbet / barrel / probe / donk / checkRaise …)。当たらなければ "other"。
  spot          String

  // トーナメント
  playersRemaining Int?   @db.SmallInt
  itmPlaces        Int?   @db.SmallInt
  bubbleDistance   Int?   @db.SmallInt
  bubbleStage      String
  stackRank        Int?   @db.SmallInt
  chipShare        Float? @db.Real
  winProb          Float? @db.Real
  itmProb          Float? @db.Real
  icmEquity        Float? @db.Real
  winProbBucket    String
  itmProbBucket    String

  // 直前の流れ
  prevHandDeltaBb       Float? @db.Real
  /// 直前のハンドで大きいポットを取ったか/落としたか("bigWin" | "bigLoss" | "none" | "first")。
  prevBigPot            String
  /// 直近の大きいポットから何ハンド目か(無ければ null)と、その種類("win" | "loss" | "none")。
  handsSinceBigPot      Int?   @db.SmallInt
  lastBigPotKind        String
  lossStreak            Int    @db.SmallInt
  handIndexInTournament Int    @db.SmallInt
  minutesIntoTournament Float? @db.Real
  stackVsStart          Float? @db.Real

  // 結果
  handResultBb   Float   @db.Real
  wentToShowdown Boolean
  wonHand        Boolean

  createdAt DateTime @default(now())

  @@unique([handId, sequenceNumber])
  /// 「自分」の集計用。
  @@index([userId])
}

/// GEO戦略DBの集計用に事前展開した「1意思決定 = 1行」のテーブル。
///
/// 以前はGEOのノードを開くたびに全ハンドの全履歴を読み出してNode側でリプレイしていたため、
/// プレイが増えるほど際限なく重くなっていた。ここへ書き出しておくことで、GEOの問い合わせを
/// インデックス1本 + GROUP BY で答えられるようにする(応答時間がデータ総量に依存しなくなる)。
///
/// 行を書くのは「実プレイヤーの意思決定」だけ(自動プレイヤー・離席中の席は書かない)。
/// 管理者が後から切り替えられる excludedFromGeo は焼き込まず、HandSeat をJOINして除外する。
model GeoDecision {
  id             String   @id @default(uuid())
  handId         String
  hand           Hand     @relation(fields: [handId], references: [id], onDelete: Cascade)
  /// excludedFromGeo を参照するための HandSeat。
  handSeatId     String
  handSeat       HandSeat @relation(fields: [handSeatId], references: [id], onDelete: Cascade)
  /// 偏差値レンジでの絞り込み用。
  userId         String
  street         String
  /// 同一ストリート内で、この意思決定の直前までのライン系列。"UTG:fold|MP:raise2-5" 形式。
  /// 要求されたラインと完全一致で引ける(要求ライン = 対象決定の直前までの系列、という対応)。
  lineKey        String
  /// ポストフロップのみ。そのストリートまでの板面。"9s,8s,7s" 形式。プリフロップは空文字。
  boardKey       String
  /// ポストフロップのみ。そのハンドのプリフロップ全系列(要求プリフロップラインの前方一致判定用)。
  preflopKey     String
  position       String
  bucket         String
  stackBucket    String
  bubbleStage    String
  playerCount    Int
  isGeometric    Boolean
  /// 13x13ハンドレンジ表の座標。分類できないホールカードは null。
  handClassRow   Int?
  handClassCol   Int?
  sequenceNumber Int

  @@index([street, lineKey, boardKey, stackBucket, bubbleStage, playerCount])
  @@index([handId])
  @@index([handSeatId])
}

model HandPot {
  id              String   @id @default(uuid())
  handId          String
  hand            Hand     @relation(fields: [handId], references: [id])
  potIndex        Int
  amount          Int
  eligibleUserIds String[]
  winnerUserIds   String[]

  @@unique([handId, potIndex])
}

/// 局後検討(GTO棋譜解析)の「正解データ」= 自社ソルバーで計算したGTO解のプリコンピュート/キャッシュ。
/// 他社サービスのスクレイピングではなく、あくまで自前で計算した自社データを格納する。
/// spotKeyは局面を正規化した一意キー(street/有効スタック帯/相対ポジション/スート正規化ボード/
/// アクションライン/ベットサイズ抽象化 を連結してハッシュ化)。詳細は packages/db/src/solverSpot.ts。
model GtoSolution {
  id             String   @id @default(uuid())
  /// 局面を正規化した一意キー(sha1)。キャッシュ命中判定に使う。
  spotKey        String   @unique
  street         String // "preflop" | "flop" | "turn" | "river"
  /// 有効スタック帯(stackBucketと同じ区分)。
  effStackBucket String
  /// 相対ポジション。ポストフロップHUは "IP" | "OOP"。プリフロップは "BTN" 等の絶対ポジション。
  heroPos        String
  /// スート正規化済みボード(例: "AaKb7c")。プリフロップは空文字。
  boardCanon     String
  /// そのストリート内で直面したアクションライン(バケット列)を連結した文字列。
  actionLine     String
  /// ベットサイズ抽象化のID(どのサイズ木で解いたか)。
  betTree        String
  /// per-actionの頻度とEVを格納したペイロード。{ actions: [{ action, freq, evBb }], ... }
  solution       Json
  /// 収束品質(exploitability, %pot等)。プリフロップの表引きは0扱い。
  exploitability Float    @default(0)
  /// 解の生成元バージョン(ソルバー版 or レンジ表版)。
  solverVersion  String   @default("preflop-table-v1")
  createdAt      DateTime @default(now())

  @@index([street, effStackBucket])
}

/// 1ハンドに対する1プレイヤー(hero)ぶんのレビュージョブ+集計結果。
model HandReview {
  id            String   @id @default(uuid())
  handId        String
  hand          Hand     @relation(fields: [handId], references: [id])
  /// レビュー対象(意思決定を分析する)プレイヤーのUser.id。
  heroUserId    String
  /// "queued" | "solving" | "explaining" | "done" | "failed"
  status        String   @default("queued")
  error         String?
  /// トナメ/ハンド単位のGTO精度%(0-100)。チェスドットコムのAccuracy相当。
  gtoAccuracy   Float?
  totalEvLossBb Float?
  mistakeCount  Int?
  artisticCount Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  decisions ReviewDecision[]

  @@unique([handId, heroUserId])
}

/// heroの1意思決定ぶんの分析結果。
model ReviewDecision {
  id               String     @id @default(uuid())
  reviewId         String
  review           HandReview @relation(fields: [reviewId], references: [id])
  /// 対応するHandAction.sequenceNumber。
  sequenceNumber   Int
  street           String
  /// 解析対象か。多人数ポストフロップ等はfalse。
  analyzable       Boolean    @default(true)
  /// 対象外の理由。"multiway" 等。
  outOfScopeReason String?
  heroPos          String
  effStackBb       Float
  potBb            Float
  facingSizeBb     Float?
  /// { action, size, bucket } 実際に取ったアクション。
  actionTaken      Json
  /// [{ action, size, freq, evBb }] GTO基準の各アクション。
  gtoActions       Json?
  evLossBb         Float?
  /// "artistic" | "best" | "great" | "excellent" | "good" | "book" | "inaccuracy" | "mistake" | "blunder" | null
  classification   String?
  /// 呼称ラベル(例 "チェックレイズ")。チャットボット未実装時の「正解表示」用。
  actionName       String?
  /// 将来のチャットボット解説文(フェーズ3)。未実装時はnull。
  explanation      String?
  spotKey          String?

  @@index([reviewId])
}

/// ユーザーが「運営に報告する」を押したときのエラー報告。
/// 画面に出ていた文言だけでなく、原因特定に必要な技術詳細(エラー種別・HTTPステータス・
/// 所要時間・通信状態など)をそのまま保存し、運営が後から読んで修正できるようにする。
model ErrorReport {
  id String @id @default(uuid())

  createdAt DateTime @default(now())

  /// 発生元の画面/機能。例: "geo" | "table" | "login" | "onboarding" | "review" 等。
  scope String

  /// 画面にユーザー向けとして出ていたメッセージ本文。
  message String

  /// 技術詳細(1行)。エラー種別・エンドポイント・HTTPステータス・所要msなど。
  detail String?

  /// 追加の構造化コンテキスト(画面ごとの状態、通信診断のスナップショット等)。
  context Json?

  /// 報告時点のアプリバージョン(例 "3.20.0")。再現条件の切り分けに使う。
  appVersion String?

  /// 端末情報とページURL。どの環境・どの画面で起きたかの特定に使う。
  userAgent String?
  url       String?

  /// ログイン中なら報告者。未ログインでも報告できるようnull許容。
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// 運営が対応済みにした時刻。未対応はnull。
  resolvedAt DateTime?

  @@index([createdAt])
  @@index([scope, createdAt])
  @@index([resolvedAt])
}

/// ホームの「ご意見フォーム」から届いた、要望・不具合の報告・その他のメッセージ。管理者画面で読む。
/// 写真は別表(FeedbackImage)に分け、一覧を読むときに画像の中身を引かない。
model Feedback {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  /// 送り主(ログイン必須)。アカウント削除で一緒に消す(写真に個人の情報が写っていることがあるため)。
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// "request"(要望)| "bug"(不具合)| "other"(その他)
  kind String
  body String

  appVersion String?
  userAgent  String?

  /// 管理者が読んだ時刻。未読はnull。
  readAt DateTime?

  images FeedbackImage[]

  @@index([createdAt])
  @@index([readAt])
}

model FeedbackImage {
  id         String   @id @default(uuid())
  feedbackId String
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  /// "image/jpeg" | "image/png" | "image/webp"
  mime       String
  data       Bytes
  bytes      Int
  /// 添付の並び順(0〜)
  position   Int

  @@index([feedbackId])
}

// ---------------------------------------------------------------------------
// SNS運用(マーケティング)
//
// 収集・監視の結果を保存する。集計ロジック自体は packages/marketing 側に置いてあり、
// ここは「いつ何を拾ったか」を残して時系列で追えるようにするだけ。
// ---------------------------------------------------------------------------

/// ④ 収集したトレンド/ニュース1件。
model TrendItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  /// 収集元の種別。"google-trends" | "google-news" | "youtube" | "hatena"。
  source String

  /// 画面に出す収集元の名前(例 "ニュース: ポーカー")。
  sourceLabel String

  title String
  link  String

  /// 元フィードが返した公開日時。取れないフィードもあるのでnull許容。
  publishedAt DateTime?

  /// ⑨ の判定結果。"critical" | "warning" | "info"。何も当たらなければnull。
  severity String?

  /// 判定の根拠になった語。人が却下できるように残す。
  severityTerms String[]

  /// 運営が確認済みにした時刻。未確認はnull。
  reviewedAt DateTime?

  /// 同じ記事を二重に保存しないための鍵。リンクが空のものは題名を使う。
  dedupeKey String @unique

  @@index([createdAt])
  @@index([severity, createdAt])
  @@index([reviewedAt])
}

/// ②⑥ 投稿の原稿と、その構造分析の結果。過去投稿の再利用元にもなる。
model SocialPost {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  /// 原稿本文(出し分け前の1本)。
  source String

  /// 実際に投稿したプラットフォーム。未投稿はnull。
  platform String?

  /// 投稿先のURL。実績を後から突き合わせるために持つ。
  postedUrl String?
  postedAt  DateTime?

  /// analyzePost の結果をそのまま入れる。閾値を変えたときの再計算元にする。
  structure Json

  /// 手動で記録する実績(表示数・いいね等)。APIが無くても運用できるようにする。
  impressions Int?
  likes       Int?
  reposts     Int?

  @@index([createdAt])
  @@index([platform, postedAt])
}

/// ①⑦ 監視対象のアカウント(自社・競合とも)。
model SocialAccount {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  platform String
  /// @を除いたハンドル。
  handle   String
  label    String

  /// 自社アカウントか(競合と区別して推移を並べるため)。
  isOwn Boolean @default(false)

  snapshots AccountSnapshot[]

  @@unique([platform, handle])
}

/// ⑦ フォロワー推移。1日1件を想定。
model AccountSnapshot {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  accountId String
  account   SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  followers Int
  following Int?
  posts     Int?

  @@index([accountId, createdAt])
}

/// 無料体験に使ったカードの指紋(Stripe の card.fingerprint)。同じカードでの2回目の無料体験を弾く
/// (別のアカウントを作っても同じカードなら体験は付かない。オーナー確定)。
model TrialFingerprint {
  fingerprint String   @id
  userId      String
  createdAt   DateTime @default(now())
}

/// インフルエンサー(ローンチパートナー)。1人に1つ、Stripe のプロモーションコード(初回の支払いが30%OFF)を発行する。
/// 決済画面でこのコードを入れて加入した人の支払いの、最初の3回分は80%・以降は解約まで20%を還元する(docs/HANDOFF_influencer_partner.md)。
model Partner {
  id                    String   @id @default(uuid())
  /// 管理用の呼び名(例 "ヒカル")。
  name                  String
  /// 連絡先(X のアカウントなど)。
  contact               String?
  note                  String?
  /// 決済画面で入れるコード(大文字英数字。例 "HIKARU30")。
  code                  String   @unique
  stripePromotionCodeId String   @unique
  /// 本人専用の明細ページの秘密の鍵(URL に入れる)。
  statementToken        String   @unique
  /// 本人のアカウント(任意)。本人が自分のコードで加入した分は報酬の対象外にする。
  userId                String?
  /// 停止したコードは決済画面で使えない(Stripe 側も active: false)。
  active                Boolean  @default(true)
  createdAt             DateTime @default(now())
}

/// インフルエンサーのコードで始まった契約(Stripe のサブスク1つにつき1行)。決済画面でコードが使われたときに記録する。
model PartnerReferral {
  id                   String   @id @default(uuid())
  partnerId            String
  stripeSubscriptionId String   @unique
  userId               String?
  /// 本人のアカウント・本人と同じカードでの加入(報酬の対象外。オーナー承認済み)。
  selfReferral         Boolean  @default(false)
  createdAt            DateTime @default(now())

  @@index([partnerId])
}

/// 報酬の台帳。入金1件・返金1件・チャージバック1件につき1行。行は書き換えず、返金はマイナスの行で打ち消す
/// (インフルエンサーへの支払いの証明に使うため)。
model PartnerLedger {
  id               String    @id @default(uuid())
  partnerId        String
  referralId       String
  /// "payment" | "refund" | "dispute"
  kind             String
  /// Stripe 側の元の id(請求書 in_ / 返金 re_ / チャージバック dp_)。Webhook の再送で二重に数えない。
  sourceId         String    @unique
  stripeInvoiceId  String?
  stripeChargeId   String?
  /// 入金なら何回目の支払いか(1〜3)。返金・チャージバックは元の入金の回。
  paymentIndex     Int
  plan             String?
  /// 入金額(円)。返金・チャージバックはマイナス。
  amount           Int
  /// 報酬(円)。対象外の入金は 0。返金・チャージバックはマイナス。
  commission       Int
  /// 対象外の理由("self" = 本人の加入 / "expired" = 期限後の加入)。対象なら null。
  voidReason       String?
  occurredAt       DateTime
  payoutId         String?
  createdAt        DateTime  @default(now())

  @@index([partnerId, occurredAt])
  @@index([stripeChargeId])
  @@index([payoutId])
}

/// インフルエンサーへの振込(月末締め・翌月末払い)。どの台帳の行を払ったかは PartnerLedger.payoutId。
model PartnerPayout {
  id        String   @id @default(uuid())
  partnerId String
  amount    Int
  /// この時刻より前の行を払った(締めの境目。日本時間の月初)。
  closedBefore DateTime
  paidAt    DateTime @default(now())
  note      String?

  @@index([partnerId])
}
